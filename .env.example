# Copy this file to `.env` (same directory as docker-compose.yml) and fill in
# strong, unique values before running `docker compose up`. Do not commit `.env`.

# Password for the MySQL root account. Only used to initialize the database;
# LPVS itself connects with the least-privilege MYSQL_USER/MYSQL_PASSWORD below.
MYSQL_ROOT_PASSWORD=

# Dedicated, least-privilege application database user (created automatically
# on first startup with access limited to the `lpvs` schema).
MYSQL_USER=lpvs
MYSQL_PASSWORD=

# Secret used to verify GitHub webhook signatures (X-Hub-Signature-256). Must match
# the "Secret" configured in the GitHub webhook settings. Generate a strong random
# value, e.g. `openssl rand -hex 32`.
LPVS_GITHUB_SECRET=
